{
  "name": "werk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frame-budget scheduler and feature-boundary build layer for large Vue CSR SPAs.",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev": "pnpm --filter @werk/sandbox dev",
    "preview": "pnpm --filter @werk/sandbox preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
